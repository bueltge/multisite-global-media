{
    "name": "bueltge/multisite-global-media",
    "type": "wordpress-muplugin",
    "description": "Multisite Global Media is a WordPress plugin which shares media across the Multisite network.",
    "keywords": [
        "wordpress",
        "muplugin",
        "multisite"
    ],
    "homepage": "https://github.com/bueltge/Multisite-Global-Media",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Dominik Schilling",
            "homepage": "https://dominikschilling.de/",
            "role": "Developer"
        },
        {
            "name": "Frank Bültge",
            "email": "f.bueltge@inpsyde.com",
            "homepage": "https://bueltge.de",
            "role": "Developer"
        },
        {
            "name": "Guido Scialfa",
            "email": "g.scialfa@inspyde.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^1.2 || ^2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3",
        "inpsyde/php-coding-standards": "^2",
        "brain/monkey": "^2.2",
        "phpunit/phpunit": "^12.5.22",
        "johnpbloch/wordpress-core": " ^5.0",
        "php-stubs/woocommerce-stubs": "^11.3",
        "php-stubs/acf-pro-stubs": "^6.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MultisiteGlobalMedia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MultisiteGlobalMedia\\Tests\\": "tests/php"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "build": "bash ./scripts/build",
        "analyze": "@php ./vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs",
        "csf": "@php ./vendor/bin/phpcbf",
        "tests": "@php ./vendor/bin/phpunit",
        "tests:no-cov": "@php ./vendor/bin/phpunit --no-coverage",
        "qa": [
            "@tests:no-cov",
            "@cs",
            "@analyze"
        ]
    },
    "extra": {
        "installer-disable": true
    }
}
