parameters:
	ignoreErrors:
		-
			message: '#^Callback expects 2 parameters, \$accepted_args is set to 1\.$#'
			identifier: arguments.count
			count: 1
			path: src/Plugin.php

		-
			message: '#^Property MultisiteGlobalMedia\\WooCommerce\\Gallery\:\:\$site is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/WooCommerce/Gallery.php

		-
			message: '#^Property MultisiteGlobalMedia\\WooCommerce\\Gallery\:\:\$siteSwitcher is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/WooCommerce/Gallery.php
